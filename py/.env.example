# The SAME .env as in AzureAI_Foundry\py: copy that file here, or copy this one to .env
# and fill in the values your trainer gives you.
# .env holds secrets: never commit it, never paste it into a chat or a public repo.

# Azure OpenAI (part of the shared Microsoft Foundry resource)
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_CHAT_DEPLOYMENT=chat
AZURE_OPENAI_EMBED_DEPLOYMENT=embed
# none = no thinking step (gpt-5.x models). Leave empty for models without reasoning.
AZURE_OPENAI_REASONING_EFFORT=none

# Azure AI Search. Students get a QUERY key: it can search but not change an index.
AZURE_SEARCH_ENDPOINT=https://<search-name>.search.windows.net
AZURE_SEARCH_KEY=<query-key>
# AZURE_SEARCH_INDEX=shopease is the Day 3 index; this session uses its own index (optional, this is the default):
AZURE_SEARCH_RAG_INDEX=shopease-rag
